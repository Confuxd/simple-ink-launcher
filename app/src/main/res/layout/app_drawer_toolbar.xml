<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <ImageButton android:id="@+id/open_launcher_settings"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_launcher_settings"
        android:padding="12dp"
        android:contentDescription="@null"
        />

    <TextView android:id="@+id/ico_minus"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:text="ico -"
        android:textStyle="bold"
        android:textSize="20sp"
        android:clickable="true"
        android:focusable="true"
        />

    <TextView android:id="@+id/ico_plus"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:text="ICO +"
        android:textStyle="bold"
        android:textSize="20sp"
        android:clickable="true"
        android:focusable="true"
        />

    <org.ds.simple.ink.launcher.toolbar.WifiSwitch
        android:id="@+id/wifi_switch"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:scaleType="fitCenter"
        android:padding="12dp"
        android:contentDescription="@null"
        />

    <org.ds.simple.ink.launcher.toolbar.BacklightSwitch
        android:id="@+id/backlight_switch"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:scaleType="fitCenter"
        android:padding="12dp"
        android:contentDescription="@null"
        />

    <ImageView android:id="@+id/last_app"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:scaleType="fitCenter"
        android:padding="10dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="invisible"
        android:contentDescription="@null"
        />

</merge>
